<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VstAudio WinUI 3 example">
    <Grid Padding="16" RowSpacing="8" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PluginText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2">
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenEditorButton" Content="Open editor" Click="OnOpenEditor" />
            <Button x:Name="CloseEditorButton" Content="Close editor" Click="OnCloseEditor" />
            <Button x:Name="RenderButton" Content="Render test tone" Click="OnRender" />
        </StackPanel>
    </Grid>
</Window>
