{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vst-audio-tauri-example",
  "identifier": "io.github.115dkk.vst-audio.tauri-example",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "vst-audio · tauri",
        "width": 520,
        "height": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
