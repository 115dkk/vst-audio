<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>VstAudio</PackageId>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>115dkk</Authors>
    <Description>Isolated-process VST2/VST3 plugin hosting and offline audio processing over vst-audio's C ABI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/115dkk/vst-audio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/115dkk/vst-audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>audio;plugin;host;vst2;vst3</PackageTags>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
    <None Include="buildTransitive/VstAudio.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
