from __future__ import annotations
from os import PathLike
from types import TracebackType
from typing import Literal
import numpy as np
import numpy.typing as npt

class VstAudioError(Exception): ...
class WorkerNotFoundError(VstAudioError): ...
class StartError(VstAudioError):
    kind: str
class RenderError(VstAudioError):
    kind: Literal["invalid_buffer", "not_running", "recovered", "timed_out", "lost"]
class RequestTimeout(VstAudioError): ...

class PluginClass:
    @property
    def id(self) -> bytes: ...
    @property
    def name(self) -> str: ...
    @property
    def vendor(self) -> str: ...
    @property
    def category(self) -> str: ...

class Parameter:
    @property
    def id(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def unit(self) -> str: ...
    @property
    def value(self) -> float: ...
    @property
    def default(self) -> float | None: ...
    @property
    def steps(self) -> int | None: ...
    @property
    def automatable(self) -> bool: ...
    @property
    def read_only(self) -> bool: ...
    @property
    def hidden(self) -> bool: ...

class Host:
    def __init__(self, worker: str | PathLike[str]) -> None: ...
    def scan(self, path: str | PathLike[str], format: str, sandboxed: bool) -> list[PluginClass]: ...
    def load(self, path: str | PathLike[str], format: str, class_id: bytes | None,
             sample_rate: int, block_size: int, sample_format: str, timeout: float) -> Plugin: ...

class Plugin:
    @property
    def input_channels(self) -> int: ...
    @property
    def output_channels(self) -> int: ...
    @property
    def sample_rate(self) -> int: ...
    @property
    def block_size(self) -> int: ...
    @property
    def latency(self) -> int: ...
    def process(self, audio: npt.NDArray[np.float32] | npt.NDArray[np.float64], *,
                tail: int = 0, timeout: float = 10.0) -> npt.NDArray[np.float32] | npt.NDArray[np.float64]: ...
    def parameters(self, *, timeout: float = 10.0) -> list[Parameter]: ...
    def set_parameter(self, id: int, value: float) -> None: ...
    def save_state(self, *, timeout: float = 10.0) -> bytes: ...
    def restore_state(self, state: bytes, *, timeout: float = 10.0) -> None: ...
    def open_editor(self) -> None: ...
    def close_editor(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Plugin: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_value: BaseException | None,
                 traceback: TracebackType | None) -> None: ...
